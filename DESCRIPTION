Type: Package
Package: chromatographR
Title: Chromatographic Data Analysis Toolset
Version: 0.8.0
Authors@R: c(
    person("Ethan", "Bass", , "ethanbass@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-6175-6739")),
    person(c("Hans","W"), "Borchers", role = c("ctb", "cph"),
